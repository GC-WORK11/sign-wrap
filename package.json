{
  "name": "sign-wrap",
  "version": "0.2.0",
  "description": "Type and control your laptop without touching it.",
  "license": "MIT",
  "private": false,
  "author": "Sign-Flow contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/GC-WORK11/sign-wrap.git"
  },
  "homepage": "https://sign-flow-eight.vercel.app",
  "bugs": "https://github.com/GC-WORK11/sign-wrap/issues",
  "keywords": [
    "sign",
    "gesture",
    "linux",
    "macos",
    "windows",
    "input",
    "phone",
    "mediapipe"
  ],
  "bin": {
    "wrap": "bin/wrap.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "server/",
    "web/",
    "app/AndroidManifest.xml",
    "app/build.sh",
    "app/src/",
    "app/res/",
    "README.md",
    "LICENSE",
    "LIMITATIONS.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "wrap": "node bin/wrap.js start",
    "start": "node bin/wrap.js start",
    "pair": "node bin/wrap.js pair",
    "doctor": "node bin/wrap.js doctor",
    "stop": "node bin/wrap.js stop",
    "status": "node bin/wrap.js status",
    "tunnel": "node bin/wrap.js tunnel",
    "test:contribute": "node --test tests/contribute.test.mjs",
    "test:kp": "node --test tests/kp-pack.test.mjs",
    "test": "cd server && python3 -m unittest discover -s tests"
  }
}
